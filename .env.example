# campus-sched 环境变量模板（配置经理拥有）
# 使用：复制为 .env 后按需修改。.env 已被 .gitignore 排除，勿提交到版本库。
# 说明：以下均为示例非秘密值，仅用于本地开发/演示。

# ===== PostgreSQL 容器（官方镜像变量，供 compose.yaml 的 db 服务读取）=====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=postgres

# ===== 后端应用连接（开发库，供 server 读取）=====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=campus_dev
DB_USERNAME=campus_app
DB_PASSWORD=campus_app_dev

# ===== 后端测试连接（测试库，供集成测试读取）=====
TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus_test
TEST_DB_USERNAME=campus_app
TEST_DB_PASSWORD=campus_app_dev

# ===== 演示数据（供 DemoDataSeeder 读取）=====
# DEMO_DATE 留空则默认“首次导入当天上海日期 + 7 天”；可用 yyyy-MM-dd 覆盖。
DEMO_DATE=
# 演示账号统一密码，供种子程序 BCrypt 编码；切勿用于生产。
DEMO_PASSWORD=demo123
# 仅 dev profile 且为 true 时导入演示数据（test-data/demo.json）。
APP_DEMO_SEED=false
# e2e 专用固定时钟（仅 e2e profile 读取）；非 e2e 环境必须留空使用真实时钟。
APP_TEST_NOW=

# ===== E2E 目标地址（供 qa Playwright 读取，指向 compose.qa.yaml 的 web 宿主端口）=====
BASE_URL=http://localhost:8089
