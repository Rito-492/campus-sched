+    @Test void oldOwnerConfirmationIsDeniedAndWithdrawalRebuildsWithoutSelf() throws Exception {
+        Flow flow = published(false);
+        UUID change = change(flow);
+        // 只在隔离测试库模拟升级前遗留的待办快照。
+        jdbc.update("UPDATE change_request SET status='AWAITING_CONFIRMATIONS', impact_json=jsonb_set(impact_json, '{requiredStaffUserIds}', ?::jsonb) WHERE id=?",
+                mapper.writeValueAsString(List.of(owner)), change);
+        jdbc.update("INSERT INTO change_confirmation(change_id,user_id) VALUES (?,?)", change, owner);
+        UUID key = UUID.randomUUID();
+        var result = call("POST", "/changes/" + change + "/confirmation", ownerToken, key, new ChangeDecision(Decision.APPROVE, ""));
+        assertEquals(403, result.status());
+        assertEquals(1, jdbc.queryForObject("SELECT count(*) FROM change_confirmation WHERE change_id=? AND user_id=? AND decision IS NULL AND decided_at IS NULL",
+                Integer.class, change, owner));
+        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM command_receipt WHERE actor_id=? AND idempotency_key=?",
+                Integer.class, owner, key.toString()));
+        assertEquals("WITHDRAWN", ok(200, "POST", "/changes/" + change + "/withdraw", ownerToken,
+                new WithdrawInput("按新规则重新发起")).path("status").asText());
+        UUID rebuilt = change(flow);
+        assertNotEquals(change, rebuilt);
+        assertEquals("PENDING_APPROVER", jdbc.queryForObject("SELECT status FROM change_request WHERE id=?", String.class, rebuilt));
+        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM change_confirmation WHERE change_id=?", Integer.class, rebuilt));
+    }
