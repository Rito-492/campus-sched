+    @Test void staleResourceReviewDisclosesDetailsOnlyAfterPermissionCheck() throws Exception {
+        Flow flow = published(false);
+        UUID change = change(flow);
+        approveChange(change);
+        // 只在隔离测试库制造已有版本 1 的改期与活动当前版本 2 不一致。
+        jdbc.update("INSERT INTO activity_version(activity_id,version_no,input_json,created_by) SELECT activity_id,2,input_json,created_by FROM activity_version WHERE activity_id=? AND version_no=1", flow.id());
+        jdbc.update("UPDATE activity SET version_no=2 WHERE id=?", flow.id());
+        var staleBody = new ChangeDecision(Decision.APPROVE, "");
+        var denied = call("POST", "/changes/" + change + "/resource-decision", staffToken, UUID.randomUUID(), staleBody);
+        assertEquals(403, denied.status());
+        assertEquals(0, denied.body().path("error").path("details").size());
+        var allowed = call("POST", "/changes/" + change + "/resource-decision", adminToken, UUID.randomUUID(), staleBody);
+        assertEquals(409, allowed.status());
+        assertEquals("STALE_VERSION", allowed.body().path("error").path("code").asText());
+        var current = activity(flow.id());
+        var details = allowed.body().path("error").path("details");
+        assertEquals(current.path("versionNo"), details.path("versionNo"));
+        assertEquals(current.path("lockVersion"), details.path("lockVersion"));
+        assertEquals(current.path("status"), details.path("status"));
+        assertEquals("PENDING_RESOURCE", jdbc.queryForObject("SELECT status FROM change_request WHERE id=?", String.class, change));
+        assertEquals(1, jdbc.queryForObject("SELECT count(*) FROM reservation WHERE activity_id=? AND status='ACTIVE'", Integer.class, flow.id()));
+    }
