<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>com.campus</groupId><artifactId>campus-events</artifactId><version>0.1.0-SNAPSHOT</version>
  <name>校园活动协同与资源调度系统</name>
  <properties><java.version>21</java.version><maven.compiler.parameters>true</maven.compiler.parameters></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><includes><include>**/*Test.java</include></includes><failIfNoTests>true</failIfNoTests></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><configuration>
      <includes><include>**/*IT.java</include></includes><failIfNoTests>true</failIfNoTests>
      <!-- QA扩展在类初始化时发布test.schema.name；Spring在创建各测试上下文时解析。
           各模块DynamicPropertySource仍有更高优先级；缺库/缺schema时失败，不回落到public。 -->
      <systemPropertiesFile>${project.basedir}/.mvn/integration-test.properties</systemPropertiesFile>
    </configuration><executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin>
  </plugins></build>
  <!-- 仅验证PM工作包。默认test/verify始终编译全部源码和验收，不启用本profile。 -->
  <profiles><profile><id>pm-isolated</id><build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration>
      <includes><include>com/campus/events/CampusEventsApplication.java</include><include>com/campus/events/foundation/**/*.java</include><include>com/campus/events/auth/**/*.java</include><include>com/campus/events/contract/**/*.java</include></includes>
      <testIncludes><testInclude>com/campus/events/foundation/**/*.java</testInclude><testInclude>com/campus/events/auth/**/*.java</testInclude><testInclude>com/campus/events/contract/**/*.java</testInclude></testIncludes>
      <!-- 此测试需要已接收的AN/DS生产模块，仅在标准构建中执行；独立PM配置不编译它。 -->
      <testExcludes><testExclude>**/PublishedModulesIT.java</testExclude><testExclude>**/StandardMavenSchemaIT.java</testExclude></testExcludes>
    </configuration></plugin>
  </plugins></build></profile></profiles>
</project>
