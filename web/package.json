{
  "name": "campus-sched-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-production.mjs && node scripts/report-bundle.mjs --check",
    "report:bundle": "node scripts/report-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "types:sync": "node scripts/sync-types.mjs",
    "types:check": "node scripts/sync-types.mjs --check",
    "test:layout": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts real-service.spec.ts",
    "test:review": "playwright test --config playwright.integration.config.ts review-regression.spec.ts",
    "test:review-persistence": "playwright test --config playwright.integration.config.ts review-restart.spec.ts",
    "test:production-ui": "playwright test --config playwright.production.config.ts",
    "test:persistence": "playwright test --config playwright.integration.config.ts persistence.spec.ts"
  },
  "dependencies": {
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "^7.1.10",
    "vitest": "4.1.12",
    "vue-tsc": "^3.1.1",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "@vue/test-utils": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
